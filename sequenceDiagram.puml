@startuml
participant Main
participant ConfigParser
queue RawQueue as "Raw Data (Q1)"
participant CoreWorkers as "Core Workers (Scatter)"
queue VerifiedQueue as "Verified Data (Q2)"
participant Aggregator as "Aggregator (Gather)"
queue ProcessedQueue as "Processed Data (Q3)"
participant Output as "Dashboard"

Main -> ConfigParser : Load config.json
Main -> RawQueue : create bounded queue
Main -> VerifiedQueue : create bounded queue
Main -> ProcessedQueue : create bounded queue

Main -> CoreWorkers : start N Processes
Main -> Aggregator : start 1 Process
Main -> Output : start 1 Process

par Concurrent Scatter-Gather Pipeline
    loop Input Stream
        Main -> RawQueue : InputModule pushes generic_packet
    end

    loop Cryptographic Verification (Parallel)
        CoreWorkers <- RawQueue : get()
        CoreWorkers -> CoreWorkers : generate_signature(PBKDF2)
        alt Signature Matches
            CoreWorkers -> VerifiedQueue : put(verified_packet)
        else Fake Data
            CoreWorkers -> CoreWorkers : drop packet
        end
    end

    loop Sequential Aggregation (Single Process)
        Aggregator <- VerifiedQueue : get()
        Aggregator -> Aggregator : _pure_running_average()
        Aggregator -> ProcessedQueue : put(final_packet)
    end

    loop UI Rendering
        Output <- ProcessedQueue : get()
        Output -> Output : draw charts & telemetry
    end
end
@enduml
